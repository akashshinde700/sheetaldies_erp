# Deployment scripts hold live server credentials — never commit them.
deploy.py
check_cert.py
DEPLOY-NOW.sh
deploy_all.py
deploy_frontend.py
deploy-to-vps.sh
seed_live.py
server-setup.sh

# Stray files from Windows shells / Python
nul_
**/nul_
__pycache__/

# Built frontend, staged here for local prod-parity testing and written by
# deploy.py on the server. Never a source file.
backend/public/

# On-premise deploy script — holds the plant server credentials.
deploy-onprem.py
onprem-restore/

# Final snapshot of the cloud install taken before shutting it down.
cloud-final-backup/

# SSH deploy key for the on-premise server.
onprem-ssh/

# Compiled Python. A .pyc of a deploy script was committed once and carries
# whatever string constants that script held.
*.pyc
*.pyo

# Per-developer Claude Code settings (the shared ones are committed).
.claude/settings.local.json
